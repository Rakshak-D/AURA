# Copy this file to .env for local development. Never commit the copy.
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
RELOAD=false
LOG_LEVEL=INFO

# Compose publishes localhost by default. Set AURA_BIND_ADDRESS deliberately
# for LAN access.
# AURA_BIND_ADDRESS=127.0.0.1
# AURA_PUBLISHED_PORT=8000

# Local model configuration (optional; API startup does not require these files).
MODEL_FILENAME=phi-3-mini-4k-instruct-q4.gguf
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
USE_GPU=false
N_GPU_LAYERS=0
CONTEXT_WINDOW=2048
LLM_MAX_TOKENS=500
LLM_TEMPERATURE=0.1

# Optional path overrides. Defaults are derived from the repository root.
# BASE_DIR=
# DATA_DIR=
# MODELS_DIR=
# DATABASE_URL=
# DB_PATH=
# CHROMA_PATH=
# UPLOADS_DIR=
# LOGS_DIR=

# Development placeholder only. Never commit a real secret.
SECRET_KEY=replace-this-local-development-placeholder
AUTH_SECRET_KEY=replace-this-local-development-secret-at-least-32-characters
AUTH_BOOTSTRAP_TOKEN=replace-this-local-bootstrap-token
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
WAKE_WORD=hey aura

# Persistent reminder worker. The database remains the source of truth.
REMINDER_SCHEDULER_ENABLED=true
REMINDER_POLL_INTERVAL_SECONDS=30
REMINDER_MAX_ATTEMPTS=3
REMINDER_PROCESSING_TIMEOUT_SECONDS=300
REMINDER_RETRY_DELAY_SECONDS=60
REMINDER_DELIVERY_TIMEOUT_SECONDS=5
WEBSOCKET_MAX_MESSAGE_BYTES=4096
WEBSOCKET_HEARTBEAT_INTERVAL_SECONDS=30
WEBSOCKET_OUTBOUND_QUEUE_SIZE=32

# Production requires a unique AUTH_SECRET_KEY with at least 32 characters.
# Never use the placeholders above outside local development.
